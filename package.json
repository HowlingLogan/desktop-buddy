{
  "name": "desktop-buddy",
  "productName": "Desktop Buddy",
  "version": "1.0.0",
  "private": true,
  "description": "A local Windows desktop companion",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "smoke:stage4": "electron . --stage4-smoke-test",
    "smoke:stage5": "electron . --stage5-smoke-test",
    "smoke:stage6": "electron . --stage6-smoke-test",
    "smoke:reset": "electron . --stage6-reset-smoke-test",
    "smoke:defaults": "electron . --stage6-defaults-smoke-test",
    "smoke:stage7a": "electron . --stage7a-smoke-test",
    "smoke:stage7b": "electron . --stage7b-smoke-test",
    "smoke:stage7c": "electron . --stage7c-smoke-test",
    "smoke:stage7d": "electron . --stage7d-smoke-test",
    "smoke:stage7e": "electron . --stage7e-smoke-test",
    "smoke:stage7f": "electron . --stage7f-smoke-test",
    "probe:activity": "electron . --stage5-system-test",
    "package:win": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  }
}
